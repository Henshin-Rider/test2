# ── Task Submitter 环境变量 ──
# 复制本文件为 .env 并填入实际值

# === TFS 模式 ===
# Mock 模式：不连真 TFS，返回假 ID。测试期务必设为 true，避免污染生产数据。
# 测试完成后改为 false 或删除，恢复连真 TFS。
MOCK_TFS=true

# TFS CLI 路径（默认指向项目内）
# TFS_CLI_PATH=tfs_api/TFSProxy/CLI/TFSProxyCLI.exe

# === AI 配置（也可在 config/projects.json 配）===
# AI_BASE_URL=https://api.minimaxi.com
# AI_API_KEY=your-key-here
# AI_MODEL=MiniMax-M2.7

# === 服务端口 ===
# PORT=3102

# === LDAP 域控（Phase 3 用）===
# 域控地址（待 IT 确认）。未配置时走 dev bypass：任意密码可登录（仅测试用）。
# LDAP_URL=ldap://dc01.united-imaging.com
# LDAP_BASE_DN=DC=united-imaging,DC=com
# 方式 A：直接拼 user DN（如 username@domain 或 DOMAIN\username 风格的 AD 也支持）
# LDAP_USER_DN_TEMPLATE=CN={user},CN=Users,DC=united-imaging,DC=com
# 方式 B：服务账号 bind 后搜索用户 DN
# LDAP_BIND_DN=CN=readonly,DC=united-imaging,DC=com
# LDAP_BIND_PASSWORD=

# === Session（Phase 3 用）===
# SESSION_SECRET=change-this-to-a-random-string
